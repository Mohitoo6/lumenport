# Copy this file to .env and fill in your own keys. .env is ignored by git; never commit keys.
#
# The AI council talks to any OpenAI-compatible chat endpoint. Providers are tried in
# order: LLM_*, then FALLBACK1_*, FALLBACK2_*, ... up to FALLBACK9_*. If one is rate-limited
# or overloaded, the next is used. Put your fastest provider first: one that does not answer
# within 20 seconds is skipped and rested for 5 minutes. REASONING_EFFORT is optional
# (low / medium / high); when it is left out the server asks for "low", because council
# replies are two sentences and hidden reasoning tokens are billed.
#
# Keys are read by the dev server (npm run dev) and never sent to the browser.

LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=
LLM_REASONING_EFFORT=low
LLM_API_KEY=

FALLBACK1_BASE_URL=https://api.groq.com/openai/v1
FALLBACK1_MODEL=
FALLBACK1_REASONING_EFFORT=low
FALLBACK1_API_KEY=

# Accounts and cloud saves (optional; see README). The anon key is public by design.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=
# VITE_SUPABASE_GOOGLE=1

# Hosted deployments only (Vercel functions in api/ always apply these; the dev server
# applies them when LLM_PUBLIC=1). Limits protect a free tier from a public page.
# LLM_PUBLIC=1
# LLM_CALLS_PER_VISITOR=30     # per visitor (IP) in a rolling ten minutes
# LLM_CALLS_PER_DAY=500        # for the whole site
# LLM_OWN_KEY_CALLS_PER_VISITOR=150  # players on their own key (no daily cap)
# LLM_MAX_PROMPT_CHARS=24000
# LLM_MAX_OUTPUT_TOKENS=1000
