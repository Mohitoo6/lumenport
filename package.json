{
  "name": "metropolis",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.sim.json",
    "test": "vitest run",
    "shots": "playwright test",
    "assets": "node scripts/fetch-assets.mjs",
    "eval:council": "EVAL_COUNCIL=1 vitest run --config vitest.eval.config.ts council",
    "eval:assistant": "EVAL_ASSISTANT=1 vitest run --config vitest.eval.config.ts assistant",
    "eval:offline": "vitest run --config vitest.eval.config.ts offline"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@preact/signals": "2.11.4",
    "n8ao": "2.0.1",
    "postprocessing": "6.39.6",
    "preact": "11.2.0",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "22.20.5",
    "@types/three": "0.187.0",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
